---
import { Page } from 'uncial';
import { contentRoutes, type ContentPage, type MetaOf } from 'uncial-cms/astro';
import Base from '../layouts/Base.astro';
import { site } from '../site.ts';

export function getStaticPaths() {
	return contentRoutes(site).getStaticPaths();
}

const { document, meta } = Astro.props as ContentPage<MetaOf<typeof site>>;
---

<Base title={meta.title}><Page model={site} {document} /></Base>
