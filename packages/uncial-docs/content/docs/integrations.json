		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Register the custom elements once on the client, then set their inputs as properties: they are objects and functions, which HTML attributes cannot carry."
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "import 'uncial/web-components';\n\nconst editor = document.querySelector('uncial-editor');\nObject.assign(editor, { model, json: doc, imageSource });\neditor.addEventListener('uncial-change', (event) => (doc = event.detail));\n\nconst renderer = document.querySelector('uncial-renderer');\nObject.assign(renderer, { model, content: doc });"
				}
			]
		},
