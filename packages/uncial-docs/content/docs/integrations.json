			"content": [
				{
					"type": "text",
					"text": "<script lang=\"ts\">\n\timport { BlockAttributesPanel, DocumentMetaPanel, Toolbar, bindEditor } from 'uncial/editor';\n\n\tconst editor = bindEditor(model);\n\tlet doc = $state({ type: 'doc', content: [{ type: 'paragraph' }] });\n\tlet meta = $state({});\n\tlet tiptap = $state(null);\n</script>\n\n<Toolbar editor={tiptap} toolbar={model.editor.toolbar} marks={model.marks} />\n<div\n\tuse:editor.attach={{\n\t\tjson: doc,\n\t\tmeta,\n\t\tonChange: (next) => (doc = next),\n\t\tonMetaChange: (next) => (meta = next),\n\t\tonEditor: (next) => (tiptap = next)\n\t}}\n></div>\n<BlockAttributesPanel {...editor.attributes} />\n<DocumentMetaPanel {...editor.meta} onCommit={(next) => (meta = next)} />"
				}
			]
		},
