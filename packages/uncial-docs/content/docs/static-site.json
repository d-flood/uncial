{
	"type": "doc",
	"version": 1,
	"meta": {
		"title": "A static site that edits itself",
		"navGroup": "Guides",
		"navOrder": 12
	},
	"content": [
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "what-you-get"
			},
			"content": [
				{
					"type": "text",
					"text": "What you get"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "A static site whose pages are Content documents in its own git repository, edited in the built site itself. There is no CMS server and no database: a save is a commit, and the commit is the deploy."
				}
			]
		},
		{
			"type": "bulletList",
			"content": [
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "A Content page, "
								},
								{
									"type": "text",
									"text": "/about/",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ", is prerendered from "
								},
								{
									"type": "text",
									"text": "content/about.json",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " and ships no editor JavaScript."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Its Editor variant, "
								},
								{
									"type": "text",
									"text": "/about/edit/",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ", draws the same Page template around the live editor."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "The Dashboard, "
								},
								{
									"type": "text",
									"text": "/uncial/",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ", manages pages, media, Globals and Collections."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "uncial-cms init",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " writes all of what follows. These docs run it."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "declare-the-site-once"
			},
			"content": [
				{
					"type": "text",
					"text": "Declare the site once"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Site options are pure data, so "
				},
				{
					"type": "text",
					"text": "vite.config.ts",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " can import them too:"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "// site.options.ts\nimport type { SiteOptions } from 'uncial-cms';\n\nexport const siteOptions = {\n\tcontentDir: 'content',      // repo-root-relative\n\tstaticDir: 'static',        // the default\n\tmediaDir: 'static/uploads', // under the static dir\n\tgithub: { repo: 'owner/name', branch: 'main' },\n\tautosaveMs: 400             // local forge only\n} satisfies SiteOptions;"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "defineSite",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " adds the Content model and returns the Site object, which every route and component takes:"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "// src/lib/site.ts\nimport { base } from '$app/paths';\nimport { defineSite } from 'uncial-cms';\nimport { siteOptions } from '../../site.options.js';\n\nexport const site = defineSite(siteOptions, {\n\tbase,\n\tblocks: import.meta.glob('./blocks/*.svelte', { eager: true }),\n\ttemplates: import.meta.glob('./templates/*.svelte', { eager: true }),\n\tmeta: { title: { default: 'Untitled page', required: true } }\n});"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The Site object is server-safe. It resolves the forge for the build (the local checkout in development, GitHub in production) and derives sign-in and the Media and file sources from the options. Omit "
				},
				{
					"type": "text",
					"text": "github",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " for a "
				},
				{
					"type": "text",
					"text": "local-only",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": " site. "
				},
				{
					"type": "text",
					"text": "localContentDir",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " names the content dir on disk when it differs from "
				},
				{
					"type": "text",
					"text": "contentDir",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", as in a monorepo package."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "wire-vite-and-kit"
			},
			"content": [
				{
					"type": "text",
					"text": "Wire Vite and Kit"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "// vite.config.ts\nplugins: [...uncialCms(siteOptions), sveltekit()]"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "js"
			},
			"content": [
				{
					"type": "text",
					"text": "// svelte.config.js\nkit: {\n\tadapter: adapter({ pages: 'build', assets: 'build' }),\n\tpaths: { base: process.argv.includes('dev') ? '' : (process.env.BASE_PATH ?? '') }\n}"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "// src/routes/+layout.ts\nexport const prerender = true;\nexport const trailingSlash = 'always';"
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "routes"
			},
			"content": [
				{
					"type": "text",
					"text": "Routes"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Each route module is one line. You own the files; the factories never register a route."
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "// src/routes/[...path]/+page.server.ts\nexport const { entries, load } = contentRoutes(site);\n\n// src/routes/[...path]/edit/+page.server.ts\nexport const { entries, load } = editorRoutes(site);"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "svelte"
			},
			"content": [
				{
					"type": "text",
					"text": "<!-- src/routes/[...path]/+page.svelte -->\n<Page {site} {data} />\n\n<!-- src/routes/[...path]/edit/+page.svelte -->\n<EditorPage {site} {data} />\n\n<!-- src/routes/uncial/+page.svelte -->\n<Dashboard {site} />"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "contentRoutes",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and "
				},
				{
					"type": "text",
					"text": "editorRoutes",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " come from "
				},
				{
					"type": "text",
					"text": "uncial-cms/sveltekit",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "; the components from "
				},
				{
					"type": "text",
					"text": "uncial-cms/svelte",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ". "
				},
				{
					"type": "text",
					"text": "load",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " 404s unknown paths, strips slashes, types "
				},
				{
					"type": "text",
					"text": "meta",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " from your fields, and caches listings outside development. Globals and Collections are never routed. To skip other files, pass "
				},
				{
					"type": "text",
					"text": "exclude: ({ path }) => …",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "EditorPage",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " loads the editor stack lazily and owns the status line, the conflict banner, the Save button, and autosave on the local forge."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "navigation"
			},
			"content": [
				{
					"type": "text",
					"text": "Navigation"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "buildNav",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " groups and orders pages by their "
				},
				{
					"type": "text",
					"text": "navGroup",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "navOrder",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and "
				},
				{
					"type": "text",
					"text": "navLabel",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " meta (falling back to "
				},
				{
					"type": "text",
					"text": "title",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "), and prefixes "
				},
				{
					"type": "text",
					"text": "base",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ":"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "import { buildNav } from 'uncial-cms';\n\nconst nav = buildNav(contentRoutes(site).list(), { base });\n// [{ kind: 'link', href, label } | { kind: 'group', id, label, links }]"
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "astro"
			},
			"content": [
				{
					"type": "text",
					"text": "Astro"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The integration injects the Editor variant and Dashboard routes inside your layout. The reader route is yours:"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "// astro.config.mjs\nintegrations: [svelte(), uncialCms(siteOptions, { site: './src/site.ts', layout: './src/Layout.astro' })]"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "svelte"
			},
			"content": [
				{
					"type": "text",
					"text": "---\n// src/pages/[...path].astro\nimport { Page } from 'uncial';\nimport { contentRoutes, type ContentPage } from 'uncial-cms/astro';\nimport Layout from '../Layout.astro';\nimport { site } from '../site.ts';\n\nexport function getStaticPaths() {\n\treturn contentRoutes(site).getStaticPaths();\n}\nconst { path, document } = Astro.props as ContentPage;\n---\n<Layout><Page model={site} {document} {path} /></Layout>"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Gate the build with "
				},
				{
					"type": "text",
					"text": "uncial-cms assert-clean-pages dist --astro",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "authorize-the-editor-s-origin"
			},
			"content": [
				{
					"type": "text",
					"text": "Authorize the editor's origin"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Signing in mints a GitHub App installation token for your one repository, with contents read/write, for about an hour. Before the auth worker mints it:"
				}
			]
		},
		{
			"type": "orderedList",
			"content": [
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Commit "
								},
								{
									"type": "text",
									"text": ".uncial/cms.json",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " to the default branch, naming the origins that may edit: "
								},
								{
									"type": "text",
									"text": "{ \"allowedOrigins\": [\"https://example.com\", \"http://localhost:5173\"] }",
									"marks": [
										{
											"type": "code"
										}
									]
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Install the "
								},
								{
									"type": "text",
									"text": "uncial-cms",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " GitHub App on the repository."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Run "
								},
								{
									"type": "text",
									"text": "pnpm exec uncial-cms doctor --origin https://example.com",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ", which checks both, and Pages, through your "
								},
								{
									"type": "text",
									"text": "gh",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " CLI."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "callout",
			"attrs": {
				"variant": "warning"
			},
			"content": [
				{
					"type": "paragraph",
					"content": [
						{
							"type": "text",
							"text": "The allowlist is keyed by origin. On "
						},
						{
							"type": "text",
							"text": "<user>.github.io",
							"marks": [
								{
									"type": "code"
								}
							]
						},
						{
							"type": "text",
							"text": ", every project site shares one origin, so allowlisting it authorizes all of them. A custom domain gives each site its own."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "To self-host the worker or use your own App, set "
				},
				{
					"type": "text",
					"text": "github.auth: { kind: 'worker', url, appSlug }",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ". To sign in through a code-exchange broker that holds your App's secret, set "
				},
				{
					"type": "text",
					"text": "{ kind: 'broker', origin, clientId, appSlug }",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and register "
				},
				{
					"type": "text",
					"text": "<base>/uncial/",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " as the App's callback URL."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "deploy"
			},
			"content": [
				{
					"type": "text",
					"text": "Deploy"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Call the reusable workflow, which checks, tests, builds, gates and deploys to Pages:"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "yaml"
			},
			"content": [
				{
					"type": "text",
					"text": "# .github/workflows/pages.yml\non: { push: { branches: [main] }, workflow_dispatch: {} }\npermissions: { contents: read, pages: write, id-token: write }\njobs:\n  site:\n    uses: d-flood/uncial/.github/workflows/static-site.yml@main\n    with:\n      base-path: /${{ github.event.repository.name }}"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Leave out "
				},
				{
					"type": "text",
					"text": "base-path",
					"marks": [
						{
