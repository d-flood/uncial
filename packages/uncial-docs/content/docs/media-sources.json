{
	"type": "doc",
	"version": 1,
	"meta": {
		"title": "Media sources",
		"navGroup": "Dashboard",
		"navOrder": 15
	},
	"content": [
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "one-library-every-forge"
			},
			"content": [
				{
					"type": "text",
					"text": "One library, every forge"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The Dashboard's Media section and the editor's image and file fields read media through one "
				},
				{
					"type": "text",
					"text": "Media source",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": ", so an upload in either place shows up in the other. The Site object derives it from the site options, "
				},
				{
					"type": "text",
					"text": "staticDir",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and "
				},
				{
					"type": "text",
					"text": "base",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "interface MediaSource {\n\tcapabilities: { metadata: boolean; usage: boolean; delete: boolean; search: boolean };\n\tlist(query?: { search?: string; contentType?: string }): Promise<MediaItem[]>;\n\tupload(file: File, opts?: { title?: string }): Promise<MediaItem>;\n\tdelete(item: MediaItem): Promise<void>;\n}"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "A "
				},
				{
					"type": "text",
					"text": "MediaItem",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " has an "
				},
				{
					"type": "text",
					"text": "id",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", a "
				},
				{
					"type": "text",
					"text": "url",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", a "
				},
				{
					"type": "text",
					"text": "filename",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and a "
				},
				{
					"type": "text",
					"text": "contentType",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", and may carry size, dimensions, title, uploader and "
				},
				{
					"type": "text",
					"text": "usage",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ". Its "
				},
				{
					"type": "text",
					"text": "url",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is what a document stores. The Media section shows only what "
				},
				{
					"type": "text",
					"text": "capabilities",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " allow."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "git-forges-the-media-dir"
			},
			"content": [
				{
					"type": "text",
					"text": "Git forges: the media dir"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "On the github and local forges, media is the files in "
				},
				{
					"type": "text",
					"text": "mediaDir",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", committed like pages. Capabilities: "
				},
				{
					"type": "text",
					"text": "{ metadata: false, usage: false, delete: true, search: false }",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			]
		},
		{
			"type": "bulletList",
			"content": [
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Upload",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " shrinks a large photo to WebP until it fits, and commits it under a hash of its bytes, so the same image uploaded twice is one file."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Delete",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " is a commit. The Media section first scans the documents for the file's URL and lists any page that uses it."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "No metadata.",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " Alt text is stored with the image value on the Block that uses it."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "A new upload is not served until the site redeploys, so the editor shows it from a local copy until then. The stored URL is always the real one."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "media-outside-the-static-dir"
			},
			"content": [
				{
					"type": "text",
					"text": "Media outside the static dir"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "With "
				},
				{
					"type": "text",
					"text": "mediaDir",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " outside the static dir and a "
				},
				{
					"type": "text",
					"text": "mediaUrlPrefix",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", the Vite plugin serves the media at "
				},
				{
					"type": "text",
					"text": "mediaUrlPrefix",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", under the base, in development and ships it in the build. "
				},
				{
					"type": "text",
					"text": "localMediaDir",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " overrides where "
				},
				{
					"type": "text",
					"text": "mediaDir",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " sits on disk."
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "// vite.config.ts\nplugins: [...uncialCms(siteOptions, { site: 'src/lib/site.ts', host: '0.0.0.0' }), sveltekit()]"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Given "
				},
				{
					"type": "text",
					"text": "site",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", the module exporting the Site object, the plugin also writes the renditions that documents, Globals and Collection records declare: in development after each save, and into the build. It loads sharp only when something declares renditions. "
				},
				{
					"type": "text",
					"text": "host",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " lets the dev server accept connections from outside a container. The Astro integration takes the same options."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "the-server-forge-the-media-library"
			},
			"content": [
				{
					"type": "text",
					"text": "The server forge: the Media library"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "On the server forge, media lives in the Media library behind the "
				},
				{
					"type": "text",
					"text": "mediaApiBase",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " given to "
				},
				{
					"type": "text",
					"text": "defineServerSite",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", with every capability: titles, dimensions, usage and search. Deleting an item still in use is refused with "
				},
				{
					"type": "text",
					"text": "MediaInUseError",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", and the Media section shows the server's message."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The Media section asks "
				},
				{
					"type": "text",
					"text": "can('media-upload')",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " before Upload and "
				},
				{
					"type": "text",
					"text": "can('media-delete', item)",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " before each Delete."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "outside-the-dashboard"
			},
			"content": [
				{
					"type": "text",
					"text": "Outside the Dashboard"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "MediaLibrary",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " from "
				},
				{
					"type": "text",
					"text": "uncial-cms/svelte",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is the Media section's grid on its own: "
				},
				{
					"type": "text",
					"text": "<MediaLibrary {source} />",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ". On the server forge, "
				},
				{
					"type": "text",
					"text": "mediaSourceFor(site.config)",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " builds its source; a git forge's media is reached only through an editing session. The editor's picker reads an "
				},
				{
					"type": "text",
					"text": "ImageSource",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " from "
				},
				{
					"type": "text",
					"text": "uncial/editor",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", not a "
				},
				{
					"type": "text",
					"text": "MediaSource",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ": to filter or add thumbnails, pass one as "
				},
				{
					"type": "text",
					"text": "media",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", or a "
				},
				{
					"type": "text",
					"text": "FileSource",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " as "
				},
				{
					"type": "text",
					"text": "files",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", in the model options to "
				},
				{
					"type": "text",
					"text": "defineSite",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "A Block's own upload flow uses the Media source in its Block context, so no CMS code reaches a Content page:"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "const block = getBlock();\n\nasync function upload(file: File) {\n\tconst src = await block.media?.upload?.(file);\n\tif (src) block.update({ src });\n}"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "upload",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " answers the value to store; "
				},
				{
					"type": "text",
					"text": "media",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is null outside the editor."
				}
			]
		}
	]
}
