					"type": "text",
					"text": "Renderer",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " to observe issues as they happen. The Renderer draws only registered Blocks and sanitizes links to http, https, mailto, tel, relative and hash URLs. Block components are trusted code; sanitize raw HTML they emit."
				}
			]
		},
