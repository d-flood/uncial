		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "page-metadata"
			},
			"content": [
				{
					"type": "text",
					"text": "Page metadata"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The Content model's "
				},
				{
					"type": "text",
					"text": "meta",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " declares the fields every page has. They use the same specs as Block attributes, are stored as JSON on the document's "
				},
				{
					"type": "text",
					"text": "meta",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", and appear in the editor's metadata panel."
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "export const model = createContentModel({\n\tblocks: import.meta.glob('./blocks/*.svelte', { eager: true }),\n\tmeta: {\n\t\ttitle: { default: 'Untitled page', required: true },\n\t\tpublishedAt: { default: '', placeholder: 'YYYY-MM-DD' }\n\t}\n});"
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "page-templates"
			},
			"content": [
				{
					"type": "text",
					"text": "Page templates"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "A Page template draws a page's shell (banner, title, navigation) from its metadata. "
				},
				{
					"type": "text",
					"text": "Page",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " draws it around the Renderer and "
				},
				{
					"type": "text",
					"text": "Editor",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " around the live editing surface, so authors edit inside the page readers get. Register a folder with "
				},
				{
					"type": "text",
					"text": "templates: import.meta.glob('./templates/*.svelte', { eager: true })",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "svelte"
			},
			"content": [
				{
					"type": "text",
					"text": "<script module lang=\"ts\">\n\timport { defineTemplate } from 'uncial';\n\n\texport const template = defineTemplate({\n\t\tid: 'feature',\n\t\tlabel: 'Feature',\n\t\tmeta: { kicker: { default: '' } },\n\t\tallowedBlocks: ['figure', 'callout']\n\t});\n</script>\n\n<script lang=\"ts\">\n\timport { Text, type TemplateProps } from 'uncial';\n\n\tlet { data, body }: TemplateProps<typeof template> = $props();\n</script>\n\n<p class=\"kicker\"><Text name=\"kicker\" /></p>\n<h1><Text name=\"title\" /></h1>\n<SubNav items={data.subnav} />\n{@render body()}"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "A page's "
				},
				{
					"type": "text",
					"text": "template",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " metadata value picks its template; with two or more, the metadata panel offers a select and the editor redraws at once. A template adds its own "
				},
				{
					"type": "text",
					"text": "meta",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "allowedBlocks",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " limits the Blocks, and route data reaches it as "
				},
				{
					"type": "text",
					"text": "data",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ". Field components inside a template edit page metadata."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
