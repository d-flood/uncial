		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "import { normalizeDocument, toHtml, toPlainText, validateDocument } from 'uncial';\n\nconst description = toPlainText(document).slice(0, 160);\nconst html = toHtml(document, model);\n\nconst schema = model.schemaFor(document.meta);\nconst result = validateDocument(normalizeDocument(document, model.blocks, schema), model.blocks, schema);"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Pass "
				},
				{
					"type": "text",
					"text": "onIssue",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " to "
				},
				{
					"type": "text",
					"text": "Editor",
