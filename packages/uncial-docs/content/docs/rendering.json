					"text": "Marks and the toolbar"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Declare a custom Mark once with "
				},
				{
					"type": "text",
					"text": "defineMark",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ". Listing it in "
				},
				{
					"type": "text",
					"text": "marks",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " registers it in the editor, the Renderer, the schema and the toolbar. The extension is a lazy import, so the model stays server-safe."
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "import { createContentModel, defaultToolbar, defineMark } from 'uncial';\nimport Highlight from './Highlight.svelte'; // <mark>{@render children()}</mark>\n\nexport const highlight = defineMark({\n\tid: 'highlight',\n\textension: () => import('@tiptap/extension-highlight'),\n\tcomponent: Highlight,\n\ttoolbar: { label: 'Highlight' }\n});\n\nexport const model = createContentModel({\n\tblocks: import.meta.glob('./blocks/*.svelte', { eager: true }),\n\tmarks: [highlight],\n\teditor: { toolbar: [...defaultToolbar, 'highlight', 'table', 'addRowAfter', 'deleteRow'] }\n});"
				}
			]
		},
