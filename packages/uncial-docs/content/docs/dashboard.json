	"content": [
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "one-route-the-whole-dashboard"
			},
			"content": [
				{
					"type": "text",
					"text": "One route, the whole Dashboard"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "/uncial/",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " is the "
				},
				{
					"type": "text",
					"text": "Dashboard",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": ", where a signed-in editor runs the site on the github, local or server forge. Its sections:"
				}
			]
		},
		{
			"type": "bulletList",
			"content": [
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Pages",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " lists, searches, creates and deletes Content documents, and opens each for editing."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Media",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " browses, uploads and deletes media. See "
								},
								{
									"type": "text",
									"text": "Media sources",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "../media-sources/"
											}
										}
									]
								},
								{
									"type": "text",
									"text": "."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Globals",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " and "
								},
								{
									"type": "text",
									"text": "Collections",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " edit site data as forms. See "
								},
								{
									"type": "text",
									"text": "Globals and Collections",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "../globals/"
											}
										}
									]
								},
								{
									"type": "text",
									"text": "."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "App sections",
									"marks": [
										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " are the host's own screens. See "
								},
								{
									"type": "text",
									"text": "App sections",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "../app-sections/"
