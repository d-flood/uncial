				{
					"type": "text",
					"text": "<uncial-dashboard>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", so any framework can host it. As with the rest of "
				},
				{
					"type": "text",
					"text": "uncial-cms",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", the package registers no route: you write the one route that renders it."
				}
			]
		},
		{
			"type": "callout",
			"attrs": {
				"variant": "tip"
			},
			"content": [
				{
					"type": "paragraph",
					"content": [
						{
							"type": "text",
							"text": "The Uncial docs you are reading run the SvelteKit route below, plus a "
