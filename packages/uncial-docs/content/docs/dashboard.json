					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and pass the same options as props. Slotted App sections are the exception: they need the custom element, whose shadow root they project into."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2
			},
			"content": [
				{
					"type": "text",
					"text": "Astro"
