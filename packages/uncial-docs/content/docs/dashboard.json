										{
											"type": "bold"
										}
									]
								},
								{
									"type": "text",
									"text": " lists the site's Content documents with search, filters and paging, creates and deletes them, and opens each one for editing."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
