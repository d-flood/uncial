			"type": "heading",
			"attrs": {
				"level": 2
			},
			"content": [
				{
					"type": "text",
					"text": "SvelteKit"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Importing "
				},
				{
					"type": "text",
					"text": "uncial-cms/dashboard",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " registers the element. Its options are objects and functions, which a prerendered attribute cannot carry, so render the element after mount and let Svelte set them as properties:"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "// src/routes/uncial/+page.server.ts\nimport { createIndexHandlers } from 'uncial-cms/sveltekit';\nimport { blocks, schema, site } from '../site.js';\n\nconst handlers = createIndexHandlers({ site, blocks, schema });\n\nexport const load = handlers.load;"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "svelte"
			},
			"content": [
				{
					"type": "text",
					"text": "<!-- src/routes/uncial/+page.svelte -->\n<script lang=\"ts\">\n\timport { onMount } from 'svelte';\n\timport { base } from '$app/paths';\n\timport 'uncial-cms/dashboard';\n\timport { blocks, schema, site } from '../site.js';\n\n\tlet mounted = $state(false);\n\tonMount(() => (mounted = true));\n</script>\n\n{#if mounted}\n\t<uncial-dashboard config={site} {blocks} {schema} basePath={base}></uncial-dashboard>\n{/if}"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "config",
					"marks": [
						{
							"type": "code"
						}
					]
