										}
									]
								},
								{
									"type": "text",
									"text": "."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "On SvelteKit, render the "
				},
				{
					"type": "text",
					"text": "Dashboard",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " component in a route with no server module:"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "svelte"
			},
			"content": [
				{
					"type": "text",
					"text": "<!-- src/routes/uncial/+page.svelte -->\n<script lang=\"ts\">\n\timport { Dashboard } from 'uncial-cms/svelte';\n\timport { site } from '$lib/site.js';\n</script>\n\n<Dashboard {site} />"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The Astro integration injects it inside your layout. Hosts without Svelte use the "
				},
				{
					"type": "text",
					"text": "<uncial-dashboard>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " element from "
				},
				{
					"type": "text",
					"text": "uncial-cms/elements",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", setting the same options as properties."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "options"
			},
			"content": [
				{
					"type": "text",
					"text": "Options"
				}
			]
		},
		{
			"type": "bulletList",
			"content": [
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "site",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ": the Site object. Required."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "editorHref(pagePath)",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ": opens a page in your own Editor variant. Without it, a page opens in the Fallback editor at "
								},
								{
									"type": "text",
									"text": "#/edit/<path>",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ", which a page created since the last deploy needs anyway."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "can(action, subject?)",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ": decides which controls to offer. See Permissions."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "appSections",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ": the host's own screens."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "signOutHref",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ": where Sign out goes on the server forge."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "theme",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": ": "
								},
								{
									"type": "text",
									"text": "'system'",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " (the default), "
								},
								{
									"type": "text",
									"text": "'light'",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": " or "
								},
								{
									"type": "text",
									"text": "'dark'",
									"marks": [
										{
											"type": "code"
										}
									]
								},
								{
									"type": "text",
									"text": "."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "routes"
			},
			"content": [
				{
					"type": "text",
					"text": "Routes"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The Dashboard routes with hash URLs, so a static host needs no rewrites: "
				},
				{
					"type": "text",
					"text": "#/pages?q=intro&page=2",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "#/edit/<path>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "#/media",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "#/globals/<name>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "#/collections/<name>/<slug>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and "
				},
				{
					"type": "text",
					"text": "#/app/<id>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "signing-in"
			},
			"content": [
				{
					"type": "text",
					"text": "Signing in"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "On github, the Dashboard signs in through the site's auth, as an Editor variant does, and shows a Sign in button because a browser blocks popups no click opened. The local forge needs no sign-in. The server forge uses the host's cookie session and links Sign out to "
				},
				{
					"type": "text",
					"text": "signOutHref",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "permissions"
			},
			"content": [
				{
					"type": "text",
					"text": "Permissions"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Before offering a control, the Dashboard asks "
				},
				{
					"type": "text",
					"text": "can(action, subject?)",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ". Without "
				},
				{
					"type": "text",
					"text": "can",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", everything is allowed, which suits a static site where repository access is the real check. The actions are "
				},
				{
					"type": "text",
					"text": "read-draft",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "save-draft",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "create",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "publish",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "unpublish",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "delete",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "move",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "restore",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "media-upload",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "text",
					"text": "media-delete",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and "
				},
				{
					"type": "text",
					"text": "global-edit",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ". The subject is the page path, the media item, the Global's name, or "
				},
				{
					"type": "text",
					"text": "<name>/<slug>",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " for a Collection record."
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "ts"
			},
			"content": [
				{
					"type": "text",
					"text": "import type { DashboardAction } from 'uncial-cms';\n\nconst can = (action: DashboardAction) => action !== 'global-edit' || isAdmin;"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "can",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " only hides controls. The forge still enforces access: repository permissions on github, and the handlers' "
				},
				{
					"type": "text",
					"text": "authorize",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " on the server."
				}
			]
		},
		{
			"type": "heading",
			"attrs": {
				"level": 2,
				"slug": "theming"
			},
			"content": [
				{
					"type": "text",
					"text": "Theming"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "The Dashboard uses the editor's "
				},
				{
					"type": "text",
					"text": "--uncial-*",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " tokens. They inherit into its shadow root, so set them on the element:"
				}
			]
		},
		{
			"type": "codeBlock",
			"attrs": {
				"language": "css"
			},
			"content": [
				{
					"type": "text",
					"text": "uncial-dashboard {\n\t--uncial-color-primary: light-dark(#7c2d12, #fdba74);\n\t--uncial-font-body: 'Inter', system-ui, sans-serif;\n}"
				}
			]
		}
	]
}
