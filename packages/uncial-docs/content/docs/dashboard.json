				{
					"type": "text",
					"text": "defineSite",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": ", so the Dashboard also finds the site's Globals there. "
				},
				{
					"type": "text",
					"text": "blocks",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and "
				},
				{
					"type": "text",
					"text": "schema",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " are the ones the route factories take, and "
				},
				{
					"type": "text",
					"text": "schema",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " may be a per-path resolver here too. A Svelte host can instead import the "
