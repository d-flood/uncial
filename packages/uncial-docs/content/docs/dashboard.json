				{
					"type": "text",
					"text": "Dashboard",
					"marks": [
						{
							"type": "bold"
						}
					]
				},
				{
					"type": "text",
					"text": ": the signed-in area where an editor runs the whole site. It is shipped by "
				},
				{
					"type": "text",
					"text": "uncial-cms",
					"marks": [
						{
							"type": "code"
						}
					]
				},
				{
					"type": "text",
					"text": " and works the same on the github, local and server forges. It has four kinds of section:"
				}
			]
		},
		{
			"type": "bulletList",
			"content": [
				{
					"type": "listItem",
					"content": [
